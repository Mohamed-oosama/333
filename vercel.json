{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/main/:path*",
      "destination": "/main-platform/:path*"
    },
    {
      "source": "/archive/:path*",
      "destination": "/archive-platform/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}